# Generates shaders_embedded.h (raw-string literals) from shaders/*.vert|frag
set(OUT_FILE "${OUT}")
file(GLOB SHADER_FILES "${SHADER_DIR}/*.vert" "${SHADER_DIR}/*.frag")
list(SORT SHADER_FILES)

set(ENTRIES "")
foreach(f ${SHADER_FILES})
  file(READ "${f}" CONTENT)
  get_filename_component(NAME "${f}" NAME)
  string(REPLACE "\\" "\\\\" CONTENT "${CONTENT}")
  string(REPLACE "\"" "\\\"" CONTENT "${CONTENT}")
  string(APPEND ENTRIES "    { \"${NAME}\", R\"GLSL(${CONTENT})GLSL\" },\n")
endforeach()

file(WRITE "${OUT_FILE}"
"// Auto-generated by cmake/embed_shaders.cmake -- do not edit.
#pragma once
#include <utility>

static const std::pair<const char *, const char *> kEmbeddedShaders[] = {
${ENTRIES}};
")
