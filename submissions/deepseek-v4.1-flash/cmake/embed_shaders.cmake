# Reads every shader source in SHADER_DIR and writes a header with raw string
# literals named SHADER_<UPPER_SNAKE_FILENAME>, e.g. raytrace.frag ->
# SHADER_RAYTRACE_FRAG.
file(GLOB _files "${SHADER_DIR}/*.frag" "${SHADER_DIR}/*.vert")
list(SORT _files)

set(_out "// Generated by cmake/embed_shaders.cmake -- do not edit.\n#pragma once\n\n")

foreach(_f ${_files})
  get_filename_component(_name "${_f}" NAME)
  string(TOUPPER "${_name}" _upper)
  string(REPLACE "." "_" _upper "${_upper}")
  string(REPLACE "-" "_" _upper "${_upper}")
  file(READ "${_f}" _src)
  string(APPEND _out "static const char* SHADER_${_upper} = R\"GLSLSRC(${_src})GLSLSRC\";\n\n")
endforeach()

file(WRITE "${OUT}" "${_out}")
