# Turns every file in SHADER_DIR into a C++ raw string literal so the
# executable is self-contained.   cmake -DSHADER_DIR=... -DOUT=... -P embed_shaders.cmake
file(GLOB SHADERS "${SHADER_DIR}/*.glsl" "${SHADER_DIR}/*.vert" "${SHADER_DIR}/*.frag")
list(SORT SHADERS)
set(CONTENT "// Generated by cmake/embed_shaders.cmake - do not edit.\n#pragma once\n\nstruct EmbeddedShader { const char* name; const char* source; };\n\n")
set(TABLE "static const EmbeddedShader kEmbeddedShaders[] = {\n")
foreach(F ${SHADERS})
    get_filename_component(NAME "${F}" NAME)
    string(MAKE_C_IDENTIFIER "${NAME}" ID)
    file(READ "${F}" SRC)
    string(APPEND CONTENT "static const char kShader_${ID}[] = R\"GLSLSRC(${SRC})GLSLSRC\";\n\n")
    string(APPEND TABLE "    {\"${NAME}\", kShader_${ID}},\n")
endforeach()
string(APPEND TABLE "};\n")
file(WRITE "${OUT}" "${CONTENT}${TABLE}")
